+@MainActor
+private final class EdgeProbeDelegate: NSObject, UINavigationControllerDelegate {
+    let animator = EdgeProbeAnimator()
+    var animations = 0
+    var interactions = 0
+    func navigationController(_ navigationController: UINavigationController, animationControllerFor operation: UINavigationController.Operation,
+                              from fromVC: UIViewController, to toVC: UIViewController) -> (any UIViewControllerAnimatedTransitioning)? {
+        animations += 1
+        return animator
+    }
+    func navigationController(_ navigationController: UINavigationController,
+                              interactionControllerFor animationController: any UIViewControllerAnimatedTransitioning) -> (any UIViewControllerInteractiveTransitioning)? {
+        interactions += 1
+        return nil
+    }
+}
+@MainActor
+private final class EdgeProbeAnimator: NSObject, UIViewControllerAnimatedTransitioning {
+    func transitionDuration(using transitionContext: (any UIViewControllerContextTransitioning)?) -> TimeInterval { 0.25 }
+    func animateTransition(using context: any UIViewControllerContextTransitioning) {
+        guard let target = context.view(forKey: .to) else { context.completeTransition(false); return }
+        context.containerView.addSubview(target)
+        target.alpha = 0
+        UIView.animate(withDuration: 0.25) { target.alpha = 1 } completion: { _ in context.completeTransition(!context.transitionWasCancelled) }
+    }
+}
